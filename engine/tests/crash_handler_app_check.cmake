# Crashes the app on purpose with --crash-test in a fresh folder with no logs/ yet (SEED-698) and checks the crash
# leaves logs/crash-*.txt naming the build and the cause, with a minidump beside it on Windows. Also a crash on
# another thread, a second crash inside the handler, a stack overflow and a logs/ that is a file, not a folder.
# Needs ICHOR and SCRATCH.
string(RANDOM LENGTH 12 ALPHABET "abcdefghijklmnopqrstuvwxyz0123456789" suffix)
set(root "${SCRATCH}/crash_handler_${suffix}")
file(REMOVE_RECURSE "${root}")

function(fail message)
    file(REMOVE_RECURSE "${root}")
    message(FATAL_ERROR "${message}")
endfunction()

# case name, --crash-test value ("-" for the bare flag), the exception code the report must name
foreach(case "main;-;0xc0000005" "thread;thread;0xc0000005" "handler;handler;0xc0000005" "overflow;overflow;0xc00000fd")
    list(GET case 0 name)
    list(GET case 1 value)
    list(GET case 2 cause)
    set(dir "${root}/${name}")
    file(MAKE_DIRECTORY "${dir}")
    set(args --headless --crash-test)
    if(NOT value STREQUAL "-")
        list(APPEND args ${value})
    endif()
    execute_process(COMMAND "${ICHOR}" ${args} WORKING_DIRECTORY "${dir}" RESULT_VARIABLE code OUTPUT_VARIABLE text ERROR_VARIABLE text)
    if(code EQUAL 0)
        fail("--crash-test ${value} exited cleanly:\n${text}")
    endif()
    file(GLOB reports "${dir}/logs/crash-*.txt")
    file(GLOB dumps "${dir}/logs/crash-*.dmp")
    list(LENGTH reports report_count)
    list(LENGTH dumps dump_count)
    if(NOT report_count EQUAL 1 OR NOT dump_count EQUAL 1)
        fail("--crash-test ${value} left ${report_count} reports and ${dump_count} minidumps, not one each (exit ${code}):\n${text}")
    endif()
    file(SIZE "${dumps}" dump_size)
    file(READ "${reports}" report)
    if(dump_size LESS 1024)
        fail("--crash-test ${value} wrote a minidump of ${dump_size} bytes")
    endif()
    if(NOT report MATCHES "^Ichor build ([0-9a-f]+(-dirty)?|unknown)\r?\n" OR NOT report MATCHES "exception ${cause}")
        fail("--crash-test ${value}: the report does not name the build and ${cause}:\n${report}")
    endif()
    if(NOT text MATCHES "\\[error\\] crash: exception ${cause}, report in ")
        fail("--crash-test ${value} did not say where the report is:\n${text}")
    endif()
endforeach()

# A logs/ that cannot be a folder: the crash still ends the process and says the report is missing.
set(dir "${root}/unwritable")
file(MAKE_DIRECTORY "${dir}")
file(WRITE "${dir}/logs" "a file where the folder should be")
execute_process(COMMAND "${ICHOR}" --headless --crash-test WORKING_DIRECTORY "${dir}" RESULT_VARIABLE code OUTPUT_VARIABLE text ERROR_VARIABLE text)
if(code EQUAL 0 OR NOT text MATCHES "\\[error\\] crash: exception 0xc0000005, the report could not be written under ")
    fail("a crash with an unwritable logs folder did not say so (exit ${code}):\n${text}")
endif()

file(REMOVE_RECURSE "${root}")
message(STATUS "five deliberate crashes each ended the app and left what they should")
