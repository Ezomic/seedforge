# The resident texture budget in the app (SEED-690). Needs ICHOR and REPO.
# The default smoke run (the same arguments as tools/check_smoke_hash.py) must hold every texture under the default
# cap with no evictions and no reloads. The kit textures are 64 square, all tail, so the eviction half runs the forged
# scene, whose Exile brings 2048 textures: with --texture-budget-mb 1 it must evict and reload, and still finish.
execute_process(COMMAND "${ICHOR}" --headless --frames 120
    WORKING_DIRECTORY "${REPO}" RESULT_VARIABLE code OUTPUT_VARIABLE text ERROR_VARIABLE text TIMEOUT 240)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "the smoke run failed (${code}):\n${text}")
endif()
if(NOT text MATCHES "texture budget: ([0-9]+) of ([0-9]+) MiB resident, ([0-9]+) textures, ([0-9]+) evictions, ([0-9]+) reloads")
    message(FATAL_ERROR "the smoke run did not log its texture budget:\n${text}")
endif()
set(used ${CMAKE_MATCH_1})
set(cap ${CMAKE_MATCH_2})
set(textures ${CMAKE_MATCH_3})
set(evictions ${CMAKE_MATCH_4})
set(reloads ${CMAKE_MATCH_5})
if(NOT cap EQUAL 512)
    message(FATAL_ERROR "the default texture budget is ${cap} MiB, not 512:\n${text}")
endif()
if(textures EQUAL 0)
    message(FATAL_ERROR "the smoke run uploaded no textures, so the budget guards nothing:\n${text}")
endif()
if(NOT used LESS cap OR NOT evictions EQUAL 0 OR NOT reloads EQUAL 0)
    message(FATAL_ERROR "the smoke run does not fit the default texture budget: ${used} of ${cap} MiB, ${evictions} evictions, ${reloads} reloads:\n${text}")
endif()
if(NOT text MATCHES "exit after 120 frames")
    message(FATAL_ERROR "the smoke run did not finish its frames:\n${text}")
endif()

execute_process(COMMAND "${ICHOR}" --headless --forged --grid 64 --seed 22 --frames 30 --texture-budget-mb 1
    WORKING_DIRECTORY "${REPO}" RESULT_VARIABLE code OUTPUT_VARIABLE text ERROR_VARIABLE text TIMEOUT 240)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "the forged run with a 1 MiB texture budget failed (${code}):\n${text}")
endif()
if(NOT text MATCHES "texture budget: ([0-9]+) of 1 MiB resident, ([0-9]+) textures, ([0-9]+) evictions, ([0-9]+) reloads")
    message(FATAL_ERROR "the 1 MiB forged run did not log its texture budget:\n${text}")
endif()
if(CMAKE_MATCH_3 EQUAL 0 OR CMAKE_MATCH_4 EQUAL 0)
    message(FATAL_ERROR "a 1 MiB texture budget evicted ${CMAKE_MATCH_3} textures and reloaded ${CMAKE_MATCH_4}; the flag changes nothing:\n${text}")
endif()
if(NOT text MATCHES "exit after 30 frames")
    message(FATAL_ERROR "the 1 MiB forged run did not finish its frames:\n${text}")
endif()
