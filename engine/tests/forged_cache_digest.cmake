# Writes the generator digest the test forged-world cache is keyed by: a hash of every source that decides what a cached
# world holds (libworldforge, which is header only, and the engine code that bakes and encodes it). Run as
#   cmake -DROOT=<repo root> -DOUT=<header> -P forged_cache_digest.cmake
# The header is rewritten only when the digest changes, so an edit that leaves the digest alone recompiles nothing.
file(GLOB_RECURSE inputs "${ROOT}/libworldforge/include/*" "${ROOT}/libworldforge/src/*")
foreach(name forged_heightfield forged_world_cache forged_phase_maps heightfield)
    file(GLOB parts "${ROOT}/engine/world/include/ichor/world/${name}.h" "${ROOT}/engine/world/src/${name}.cpp")
    list(APPEND inputs ${parts})
endforeach()
list(APPEND inputs "${ROOT}/engine/world/include/ichor/world/world_desc.h" "${ROOT}/engine/core/include/ichor/core/binary.h" "${ROOT}/engine/core/include/ichor/core/hash.h")
list(SORT inputs)
set(digest "")
foreach(path IN LISTS inputs)
    if(EXISTS "${path}")
        file(READ "${path}" text)
        string(REPLACE "\r\n" "\n" text "${text}")
        string(SHA256 sum "${text}")
        file(RELATIVE_PATH rel "${ROOT}" "${path}")
        string(APPEND digest "${rel}=${sum};")
    endif()
endforeach()
string(SHA256 digest "${digest}")
string(SUBSTRING "${digest}" 0 16 digest)
set(content "#pragma once\n\nnamespace ichor::test {\n\ninline constexpr const char* kForgedCacheDigest = \"${digest}\";\n\n}\n")
set(existing "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" existing)
endif()
if(NOT existing STREQUAL content)
    file(WRITE "${OUT}" "${content}")
endif()
