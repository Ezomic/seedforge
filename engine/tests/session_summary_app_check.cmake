# Runs the app headless twice in a fresh folder and checks each run leaves its own playtest session summary
# under logs/ (SEED-696): the second does not overwrite the first, the fields describe the run, and the
# --saves path given on the command line is not in it. Needs ICHOR and SCRATCH.
string(RANDOM LENGTH 12 ALPHABET "abcdefghijklmnopqrstuvwxyz0123456789" suffix)
set(dir "${SCRATCH}/session_summary_${suffix}")
file(REMOVE_RECURSE "${dir}")
file(MAKE_DIRECTORY "${dir}")

foreach(run 1 2)
    execute_process(COMMAND "${ICHOR}" --headless --seed 5 --frames 30 --saves "${dir}/saves"
        WORKING_DIRECTORY "${dir}" RESULT_VARIABLE code OUTPUT_VARIABLE text ERROR_VARIABLE text)
    if(NOT code EQUAL 0 OR NOT text MATCHES "session summary written to")
        file(REMOVE_RECURSE "${dir}")
        message(FATAL_ERROR "run ${run} wrote no session summary (exit ${code}):\n${text}")
    endif()
endforeach()

file(GLOB summaries "${dir}/logs/session-*.json")
list(LENGTH summaries count)
if(NOT count EQUAL 2)
    file(REMOVE_RECURSE "${dir}")
    message(FATAL_ERROR "two runs left ${count} session summaries, not 2: ${summaries}")
endif()

list(GET summaries 0 first)
file(READ "${first}" json)
file(REMOVE_RECURSE "${dir}")
string(JSON build GET "${json}" build_version)
if(NOT build MATCHES "^([0-9a-f]+(-dirty)?|unknown)$")
    message(FATAL_ERROR "build_version '${build}' is not the SEED-691 stamp:\n${json}")
endif()
string(JSON seed GET "${json}" seed)
string(JSON frames GET "${json}" frames)
string(JSON p50 GET "${json}" fps p50)
string(JSON flag_count LENGTH "${json}" flags)
string(JSON saves_value GET "${json}" flags 6)
string(JSON stamina GET "${json}" deaths_by_cause stamina)
if(NOT seed EQUAL 5 OR NOT frames EQUAL 30 OR NOT flag_count EQUAL 7 OR NOT saves_value STREQUAL "<path>" OR NOT stamina EQUAL 0)
    message(FATAL_ERROR "the session summary does not describe the run:\n${json}")
endif()
# A headless frame is one fixed tick of 1/60 s, so the median is exactly 60 fps.
if(NOT p50 STREQUAL "60.0")
    message(FATAL_ERROR "a headless run's median fps is ${p50}, not 60.0:\n${json}")
endif()
string(FIND "${json}" "session_summary_${suffix}" leaked)
if(NOT leaked EQUAL -1)
    message(FATAL_ERROR "the session summary carries a path from the command line:\n${json}")
endif()
message(STATUS "two headless runs left two session summaries")
