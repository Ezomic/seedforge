{
  "version": 6,
  "configurePresets": [
    {
      "name": "vcpkg",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": { "VCPKG_OVERLAY_PORTS": "${sourceDir}/ports" }
    },
    {
      "name": "windows",
      "inherits": "vcpkg",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-ci",
      "inherits": "vcpkg",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_POLICY_DEFAULT_CMP0141": "NEW",
        "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "Embedded"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux-headless-asan",
      "inherits": "vcpkg",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "ENGINE_RUNTIME": "OFF",
        "ENGINE_SANITIZERS": "ON",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows", "configuration": "Debug" },
    { "name": "windows-release", "configurePreset": "windows", "configuration": "Release" },
    { "name": "windows-ci", "configurePreset": "windows-ci" },
    { "name": "linux-headless-asan", "configurePreset": "linux-headless-asan" }
  ],
  "testPresets": [
    { "name": "windows-debug", "configurePreset": "windows", "configuration": "Debug", "output": { "outputOnFailure": true },
      "execution": { "jobs": 4 } },
    { "name": "windows-release", "configurePreset": "windows", "configuration": "Release", "output": { "outputOnFailure": true },
      "execution": { "jobs": 4 } },
    { "name": "windows-ci", "configurePreset": "windows-ci", "output": { "outputOnFailure": true },
      "execution": { "jobs": 4 } },
    { "name": "linux-headless-asan", "configurePreset": "linux-headless-asan", "output": { "outputOnFailure": true },
      "execution": { "jobs": 4 } }
  ]
}
